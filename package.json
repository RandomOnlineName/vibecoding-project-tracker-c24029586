{
  "name": "vibetracker-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,green \"vite\" \"node --watch server/index.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "mariadb -u root -p < server/schema.sql",
    "db:seed": "node server/seed.js",
    "db:test": "node server/test-db.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^12.0.2",
    "mysql2": "^3.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.8"
  }
}
