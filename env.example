# ==============================================================================
# VibeTracker Environment Variables
# Copy this file to .env:  cp env.example .env
# ==============================================================================

# Server Port and Security
PORT=3001
JWT_SECRET=vibetracker-dev-secret-change-in-prod

# Database Engine Selection:
# Set to 'sqlite' for zero-config, embedded serverless SQLite (Option 1).
# Auto-enabled on Vercel without needing external databases.
# Set to 'mysql' if connecting to a real MariaDB / MySQL server (Option 2).
DB_CLIENT=sqlite

# Auto-Regenerate Database on Startup:
# When set to 'true', the server will clear and re-populate the demo dataset
# (5 team members, tasks, and deliverables) automatically every time it starts.
DB_RESET_ON_BOOT=true

# --- MySQL / MariaDB Settings (Used only if DB_CLIENT=mysql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vibetracker
DB_PASSWORD=change-me
DB_NAME=vibetracker
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SKIP_CREATE=false
